<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Static model whose world pose is updated kinematically via UserCommands.
       Local +X is the closing direction. Retraction = pose at spawn.
       Only one collision box and one matching visual box: no joints, no motors. -->
  <model name="maze_gate">
    <static>true</static>
    <link name="gate_bar">
      <!-- Preserves the former slider initial offset and dimensions. -->
      <collision name="bar_collision">
        <pose>0.12 0 0 0 0 0</pose>
        <geometry><box><size>0.55 0.03 0.22</size></box></geometry>
      </collision>
      <visual name="bar_visual">
        <pose>0.12 0 0 0 0 0</pose>
        <geometry><box><size>0.55 0.03 0.22</size></box></geometry>
        <material>
          <ambient>0.36 0.52 0.66 1</ambient>
          <diffuse>0.39 0.57 0.72 1</diffuse>
          <specular>0.07 0.08 0.09 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
